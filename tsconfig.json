{
  "extends": "@keboola/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node", "vitest/globals"],
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "integtests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
